HTTP_ADDR=0.0.0.0:8081
GRPC_LISTEN_ADDR=0.0.0.0:9091
GRPC_TARGET=127.0.0.1:9091

READ_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

HARDWARE_VERSION=1.2
SOFTWARE_VERSION=2.2
FIRMWARE_VERSION=3.2
DEVICE_STATUS=healthy

HEALTH_BEHAVIOR=healthy
DIAGNOSTICS_BEHAVIOR=healthy
RESPONSE_DELAY=3s
FAILURE_COUNT=0
ERROR_STATUS=503

CHECKSUM_BINARY=/app/checksumstub
CHECKSUM_ARGS=
CHECKSUM_TIMEOUT=2s