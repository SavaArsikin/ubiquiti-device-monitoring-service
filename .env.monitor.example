LOG_FORMAT=local
LOG_LEVEL=info

DATABASE_URL=postgres://monitor:change-me@127.0.0.1:5432/device_monitor?sslmode=disable

HTTP_ADDR=127.0.0.1:8080
GRPC_ADDR=127.0.0.1:9090

API_USERNAME=demo
API_PASSWORD=replace-with-a-local-demo-password

POLL_INTERVAL=10s
PROBE_TIMEOUT=2s
RETRY_DELAY=250ms
MAX_RETRIES=1
FAILURE_THRESHOLD=3
HISTORY_RETENTION=24h
MAX_CONCURRENT_PROBES=10