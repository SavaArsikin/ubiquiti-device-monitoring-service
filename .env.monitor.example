LOG_FORMAT=local
LOG_LEVEL=info

DATABASE_URL=postgres://admin:admin@127.0.0.1:5432/device_monitoring_service?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONNECT_TIMEOUT=5s
DB_MIGRATION_TIMEOUT=30s

HTTP_ADDR=127.0.0.1:8080

API_USERNAME=demo
API_PASSWORD=replace-with-a-local-demo-password

POLL_INTERVAL=10s
PROBE_TIMEOUT=2s
RETRY_DELAY=250ms
MAX_RETRIES=1
FAILURE_THRESHOLD=3
MAX_CONCURRENT_PROBES=10
SHUTDOWN_TIMEOUT=10s